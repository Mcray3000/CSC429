[flake8]
max-line-length = 100
exclude =
    .git,
    __pycache__,
    venv,
    .venv,
    build,
    dist,
    *.egg-info
ignore =
    E203, E501,W503
     # whitespace before ':'
     # line too long (handled by black)
    # line break before binary operator
per-file-ignores =
    __init__.py:F401
